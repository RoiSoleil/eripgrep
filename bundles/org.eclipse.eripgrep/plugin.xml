<?xml version="1.0" encoding="UTF-8"?>
<?eclipse version="3.4"?>
<plugin>
   <extension
         point="org.eclipse.ui.views">
      <view
            class="org.eclipse.eripgrep.ui.ERipGrepViewPart"
            icon="icons/eripgrep.png"
            id="org.eclipse.eripgrep.ERipGrepView"
            name="ERipGrep"
            restorable="true">
      </view>
   </extension>
   <extension
         point="org.eclipse.ui.perspectiveExtensions">
      <perspectiveExtension
            targetID="*">
         <viewShortcut
               id="org.eclipse.eripgrep.ERipGrepView">
         </viewShortcut>
      </perspectiveExtension>
   </extension>
   <extension
         point="org.eclipse.ui.preferencePages">
      <page
            class="org.eclipse.eripgrep.ui.PreferencePage"
            id="org.eclipse.eripgrep.PreferencePage"
            name="ERipGrep">
      </page>
   </extension>
   <extension
         point="org.eclipse.ui.commands">
      <command
            defaultHandler="org.eclipse.eripgrep.ui.SearchWithERipGrepHandler"
            description="Searches the selected text in the workspace with RipGrep, or opens the ERipGrep view"
            id="org.eclipse.eripgrep.SearchWithERipGrepCommand"
            name="Search with ERipGrep">
      </command>
   </extension>
   <extension
         point="org.eclipse.ui.commandImages">
      <image
            commandId="org.eclipse.eripgrep.SearchWithERipGrepCommand"
            icon="icons/eripgrep.png">
      </image>
   </extension>
   <extension
         point="org.eclipse.ui.bindings">
      <key
            commandId="org.eclipse.eripgrep.SearchWithERipGrepCommand"
            contextId="org.eclipse.ui.contexts.window"
            schemeId="org.eclipse.ui.defaultAcceleratorConfiguration"
            sequence="CTRL+SHIFT+ALT+G">
      </key>
   </extension>
   <extension
         point="org.eclipse.ui.menus">
      <menuContribution
            locationURI="toolbar:org.eclipse.ui.main.toolbar?after=additions">
         <toolbar
               id="org.eclipse.eripgrep.toolbar">
            <command
                  commandId="org.eclipse.eripgrep.SearchWithERipGrepCommand"
                  style="push">
            </command>
         </toolbar>
      </menuContribution>
      <menuContribution
            locationURI="menu:org.eclipse.search.menu?after=dialogGroup">
         <command
               commandId="org.eclipse.eripgrep.SearchWithERipGrepCommand"
               style="push">
         </command>
      </menuContribution>
   </extension>
   <extension
         point="org.eclipse.core.runtime.preferences">
      <initializer
            class="org.eclipse.eripgrep.PreferenceInitializer">
      </initializer>
   </extension>

</plugin>
